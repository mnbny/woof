{
  "name": "@mnbny/woof",
  "version": "0.0.0",
  "private": true,
  "description": "Local CLI for reusable instructions, prompts, and computed resources",
  "type": "module",
  "bin": {
    "woof": "./cli/woof.bundle.mjs"
  },
  "files": [
    "cli/woof.bundle.mjs",
    "cli/templates/*.md",
    "cli/templates/editor.html",
    "skills/woof-execution/SKILL.md"
  ],
  "scripts": {
    "build": "tsx .tools/scripts/build.ts",
    "prepack": "pnpm build",
    "test": "vitest run --config .tools/tests/vitest.config.ts",
    "validate": "tsx .tools/scripts/scripty.ts --sequential && pnpm build",
    "validate:format": "SCRIPTY=1 prettier --write . --ignore-unknown --cache --log-level=error",
    "validate:lint": "SCRIPTY=2 eslint --fix --cache --format=pretty .",
    "validate:typecheck": "SCRIPTY=3 tsc --noEmit"
  },
  "devDependencies": {
    "@chatwoot/pico-search": "0.6.2",
    "@clack/prompts": "1.8.1",
    "@eslint/js": "10.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "ansis": "4.4.0",
    "change-case": "5.4.4",
    "citty": "0.2.2",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-pretty": "7.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "marked": "18.1.2",
    "picomatch": "4.0.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.3",
    "prettier-plugin-sh": "0.20.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "valibot": "1.5.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
